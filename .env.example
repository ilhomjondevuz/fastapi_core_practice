# Database
DATABASE_URL=postgresql+asyncpg://username:password@host:5432/database_name

# JWT (SECRET_KEY yaratish: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password reset (ixtiyoriy, default: 15 daqiqa va 5 urinish)
RESET_TOKEN_EXPIRE_MINUTES=15
RESET_CODE_MAX_ATTEMPTS=5

# SMTP (Gmail uchun App password kerak)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=your.email@gmail.com

# Frontend
FRONTEND_URL=http://localhost:3000